# ========================================================
# Infinx Anime Streaming Platform - Production Environment
# ========================================================

# Database Configuration (Used by MySQL container & Prisma)
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DB=infinx
DATABASE_URL="mysql://root:your_secure_mysql_password@db:3306/infinx"

# Server Configuration
PORT=8000
JWT_SECRET=replace_with_super_secret_jwt_random_string_2026
WORKER_WEBHOOK_SECRET=replace_with_worker_shared_secret_2026

# Redis Queue Configuration (Container network uses redis:6379)
REDIS_URL=redis://redis:6379

# Storage Mode Configuration:
# 'local' = stores videos/posters locally in ./uploads folder
# 's3'    = uploads transcoded video segments and posters to AWS S3
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=

# AWS S3 Storage Configuration (Required if STORAGE_TYPE=s3 or to stream existing S3 media)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name

# Seed Admin User Setup
ADMIN_EMAIL=admin@infinx.com
ADMIN_PASSWORD=your_strong_admin_password

