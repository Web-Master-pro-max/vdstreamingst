{
  "version": 2,
  "builds": [
    { "src": "**/*.html", "use": "@vercel/static" },
    { "src": "**/*.css", "use": "@vercel/static" },
    { "src": "**/*.js", "use": "@vercel/static" },
    { "src": "**/*.png", "use": "@vercel/static" },
    { "src": "**/*.jpg", "use": "@vercel/static" },
    { "src": "**/*.jpeg", "use": "@vercel/static" },
    { "src": "**/*.svg", "use": "@vercel/static" },
    { "src": "**/*.webp", "use": "@vercel/static" },
    { "src": "**/*.gif", "use": "@vercel/static" },
    { "src": "**/*.ico", "use": "@vercel/static" },
    { "src": "**/*.json", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "Postes/**", "use": "@vercel/static" },
    { "src": "img/**", "use": "@vercel/static" },
    { "src": "AMovies-Poster/**", "use": "@vercel/static" },
    { "src": "Horror-poster/**", "use": "@vercel/static" },
    { "src": "video-player/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://13.202.95.5:8000/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true"
      },
      "continue": false
    },
    {
      "src": "/uploads/(.*)",
      "dest": "http://13.202.95.5:8000/uploads/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": false
    },
    {
      "src": "/ec2-uploads/(.*)",
      "dest": "http://13.202.95.5:8000/uploads/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS"
      },
      "continue": false
    },
    {
      "src": "/posters/(.*)",
      "dest": "http://13.202.95.5:8000/posters/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS"
      },
      "continue": false
    },
    {
      "src": "/banners/(.*)",
      "dest": "http://13.202.95.5:8000/banners/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS"
      },
      "continue": false
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "http://13.202.95.5:8000/socket.io/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true"
      },
      "continue": false
    },
    {
      "src": "/laptop-api/(.*)",
      "dest": "http://13.202.95.5:8000/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true"
      },
      "continue": false
    },
    {
      "src": "/lunar-api/(.*)",
      "dest": "https://api.lunarx.to/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With",
        "Access-Control-Allow-Credentials": "true"
      },
      "continue": false
    },
    {
      "src": "/(?:profile|watch|party|video-player)/assets/(.*)",
      "dest": "http://13.202.95.5:8000/assets/$1"
    },
    {
      "src": "/(?:profile|watch|party|video-player)/Postes/(.*)",
      "dest": "http://13.202.95.5:8000/Postes/$1"
    },
    {
      "src": "/(?:profile|watch|party|video-player)/uploads/(.*)",
      "dest": "http://13.202.95.5:8000/uploads/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "http://13.202.95.5:8000/assets/$1"
    },
    {
      "src": "/av-(.*)",
      "dest": "http://13.202.95.5:8000/assets/avatars/av-$1"
    },
    {
      "src": "/Postes/(.*)",
      "dest": "http://13.202.95.5:8000/Postes/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "http://13.202.95.5:8000/img/$1"
    },
    {
      "src": "/AMovies-Poster/(.*)",
      "dest": "http://13.202.95.5:8000/AMovies-Poster/$1"
    },
    {
      "src": "/Horror-poster/(.*)",
      "dest": "http://13.202.95.5:8000/Horror-poster/$1"
    },
    {
      "src": "/video-player/(.*\\.(?:css|js|png|jpg|jpeg|svg|ico|json|map|webp|avif|gif|ttf|woff2?|eot|vtt|m3u8|ts))",
      "dest": "/video-player/$1"
    },
    {
      "src": "/(?:profile|watch|party)/(.*\\.(?:css|js|png|jpg|jpeg|svg|ico|json|map|webp|avif|gif|ttf|woff2?|eot|vtt|m3u8|ts))",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.(?:css|js|png|jpg|jpeg|svg|ico|json|map|webp|avif|gif|ttf|woff2?|eot|vtt|m3u8|ts))",
      "dest": "/$1"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/anime",
      "dest": "/anime.html"
    },
    {
      "src": "/download",
      "dest": "/download.html"
    },
    {
      "src": "/live_admin",
      "dest": "/live_admin.html"
    },
    {
      "src": "/profile",
      "dest": "/profile.html"
    },
    {
      "src": "/profile/(.*)",
      "dest": "/profile.html"
    },
    {
      "src": "/view",
      "dest": "/view.html"
    },
    {
      "src": "/watch",
      "dest": "/video-player/index.html"
    },
    {
      "src": "/watch/(.*)",
      "dest": "/video-player/index.html"
    },
    {
      "src": "/party",
      "dest": "/video-player/index.html"
    },
    {
      "src": "/party/(.*)",
      "dest": "/video-player/index.html"
    },
    {
      "src": "/video-player",
      "dest": "/video-player/index.html"
    },
    {
      "src": "/video-player/(.*)",
      "dest": "/video-player/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/home",
      "dest": "/index.html"
    },
    {
      "src": "/([^/]+)/?",
      "dest": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/Postes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        }
      ]
    }
  ]
}