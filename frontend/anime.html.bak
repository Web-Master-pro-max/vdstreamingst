  <!-- ==================== BACKEND & INTERACTIVE JAVASCRIPT ==================== -->
  <script>
    // Local Backend Address Resolver
    const getLocalBackend = () => {
      const saved = localStorage.getItem('infinx_server_url');
      if (saved && !saved.startsWith('file:')) return saved.replace(/\/$/, '');
      if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
        return 'http://localhost:8000';
      }
      return 'http://13.202.95.5:8000';
    };

    const API_BASE = (window.location.protocol === 'file:')
      ? getLocalBackend() + '/api'
      : '/api';
    window.API_BASE = API_BASE;

    window.formatMediaUrl = (url) => {
      if (!url) return '';
      if (url.startsWith('http://') || url.startsWith('https://')) return url;
      return `${API_BASE.replace('/api', '')}/${url.replace(/^\//, '')}`;
    };

    // State Variables
    let currentPage = 1;
    let totalPages = 1;
    let currentTab = 'trending';
    let currentFilters = {
      search: '',
      genre: 'all',
      format: 'all',
      season: 'all',
      year: 'all',
      status: 'all',
      sort: 'TRENDING_DESC'
    };

    // Watchlist State
    let userWatchlist = [];
    try {
      userWatchlist = JSON.parse(localStorage.getItem('infinx_watchlist') || '[]');
    } catch (e) { }

    // DOM Elements
    const animeGrid = document.getElementById('animeGrid');
    const resultsCountBadge = document.getElementById('resultsCountBadge');
    const catalogSectionTitle = document.getElementById('catalogSectionTitle');
    const prevPageBtn = document.getElementById('prevPageBtn');
    const nextPageBtn = document.getElementById('nextPageBtn');
    const pageIndicator = document.getElementById('pageIndicator');
    const jumpInput = document.getElementById('jumpInput');
    const jumpBtn = document.getElementById('jumpBtn');

    // App Initialization
    document.addEventListener('DOMContentLoaded', async () => {
      updateAuthHeader();
      initSpotlight();
      setupFilterListeners();
      setupSearchListeners();
      setupMobileMenu();
      setupLayoutSwitcher();
      loadAnimeContinueWatching();
      await loadCatalog();
    });

    // Continue Watching for Anime
    async function loadAnimeContinueWatching() {
      try {
        let list = [];
        try {
          const raw = localStorage.getItem('@infinx_continue_watching');
          if (raw) list = JSON.parse(raw);
          if (!Array.isArray(list)) list = [];
        } catch (e) { list = []; }

        // Filter for anime items
        list = list.filter(item => item && (item.isLunar || item.lunarId || item.anilistId));

        // If logged in, also fetch from server history
        const token = localStorage.getItem('infinx_token');
        if (token) {
          try {
            const res = await fetch(`${API_BASE}/user/history`, {
              headers: { 'Authorization': `Bearer ${token}` }
            });
            if (res.ok) {
              const serverList = await res.json();
              const serverAnime = (serverList || []).filter(item => item && (item.isLunar || item.lunarId || item.episode?.show?.isLunar));
              serverAnime.forEach(sItem => {
                const anilistId = sItem.lunarId || sItem.episode?.show?.anilistId;
                const exists = list.some(l => String(l.lunarId || l.anilistId) === String(anilistId));
                if (!exists) {
                  list.push({
                    isLunar: true,
                    lunarId: anilistId,
                    title: sItem.episode?.show?.title || 'Anime Series',
                    poster: sItem.episode?.show?.poster,
                    episodeNumber: sItem.episodeNumber || sItem.episode?.episodeNumber || 1,
                    progress: sItem.progress,
                    duration: sItem.duration,
                    percent: sItem.duration ? Math.round((sItem.progress / sItem.duration) * 100) : 0
                  });
                }
              });
            }
          } catch (e) { }
        }

        const section = document.getElementById('animeContinueWatchingSection');
        const grid = document.getElementById('animeContinueWatchingGrid');
        if (!section || !grid) return;

        if (list.length === 0) {
          section.style.display = 'none';
          return;
        }

        section.style.display = 'block';
        grid.innerHTML = list.slice(0, 8).map(item => {
          const anilistId = item.lunarId || item.anilistId;
          const ep = item.episodeNumber || 1;
          const title = item.title || 'Anime';
          const poster = item.poster || 'Postes/spyfamS3p.jpg';
          const percent = Math.min(100, Math.max(1, item.percent || (item.duration ? Math.round((item.progress / item.duration) * 100) : 0)));
          const seekParam = item.progress > 5 ? `&t=${Math.floor(item.progress)}` : '';
          const playUrl = `/watch?id=${anilistId}&ep=${ep}${seekParam}`;

          return `
            <div class="group relative flex flex-col rounded-xl overflow-hidden bg-surface-container-low border border-white/5 hover:border-secondary-container/40 transition-all cursor-pointer" onclick="window.requireAuthPlay(event, '${playUrl}')">
              <div class="relative w-full aspect-[2/3] overflow-hidden bg-surface-container-highest">
                <img src="${poster}" alt="${title}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" onerror="this.onerror=null; this.src='Postes/spyfamS3p.jpg';">
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/40"></div>
                <div class="absolute top-2 left-2">
                  <span class="px-1.5 py-0.5 rounded bg-primary-container text-white font-label-sm text-[9px] font-bold">Ep ${ep}</span>
                </div>
                <!-- Progress bar -->
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-black/60 z-10">
                  <div class="h-full bg-secondary-container" style="width: ${percent}%;"></div>
                </div>
              </div>
              <div class="p-2 flex flex-col gap-0.5">
                <h4 class="font-headline-sm text-xs font-bold text-white truncate group-hover:text-secondary-container transition-colors" title="${title}">${title}</h4>
                <div class="flex items-center justify-between font-label-sm text-[10px] text-outline">
                  <span>Episode ${ep}</span>
                  <span class="text-secondary font-bold">${percent}%</span>
                </div>
              </div>
            </div>
          `;
        }).join('');
      } catch (err) {
        console.error('Error loading anime continue watching:', err);
      }
    }

    // Dynamic Auth Header
    function updateAuthHeader() {
      const authHeader = document.getElementById('authHeader');
      const drawerAuthHeader = document.getElementById('drawerAuthHeader');
      const token = localStorage.getItem('infinx_token');
      const email = localStorage.getItem('infinx_user_email') || 'User';
      const role = localStorage.getItem('infinx_user_role');
      const userRaw = localStorage.getItem('infinx_user');
      let user = null;
      try { if (userRaw) user = JSON.parse(userRaw); } catch (e) { }

      const username = localStorage.getItem('infinx_username') || (user && user.username) || email.split('@')[0];
      const displayName = username.charAt(0).toUpperCase() + username.slice(1);
      const rawAvatar = localStorage.getItem('infinx_avatar') || (user && user.avatarUrl);
      let avatarUrl = null;
      if (rawAvatar && typeof rawAvatar === 'string') {
        const trimmed = rawAvatar.trim();
        if (trimmed.startsWith('http://') || trimmed.startsWith('https://') || trimmed.startsWith('data:')) {
          avatarUrl = trimmed;
        } else if (trimmed.startsWith('assets/') || trimmed.startsWith('uploads/') || trimmed.startsWith('Postes/')) {
          avatarUrl = '/' + trimmed;
        } else if (trimmed.startsWith('/assets/') || trimmed.startsWith('/uploads/') || trimmed.startsWith('/Postes/')) {
          avatarUrl = trimmed;
        } else if (trimmed.startsWith('av-') || trimmed.endsWith('.png') || trimmed.endsWith('.jpg') || trimmed.endsWith('.jpeg')) {
          avatarUrl = `/assets/avatars/${trimmed.replace(/^\/+/, '')}`;
        } else {
          avatarUrl = trimmed;
        }
      }
      const avatarFrame = localStorage.getItem('infinx_avatar_frame') || (user && user.avatarFrame) || 'default';
      const initial = (displayName || email || 'U')[0].toUpperCase();

      const avatarHtml = avatarUrl ?
        `<div class="user-avatar aura-${avatarFrame}" title="${displayName} (${email})"><img src="${avatarUrl}" alt="${displayName}" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" /><span style="display:none;">${initial}</span></div>` :
        `<div class="user-avatar aura-${avatarFrame}" title="${displayName} (${email})">${initial}</div>`;

      if (token) {
        authHeader.innerHTML = `
          <div class="flex items-center gap-2.5">
            <a href="profile.html" class="hidden sm:inline-flex items-center gap-1.5 text-white hover:text-secondary-container font-headline-sm text-sm font-bold transition-colors">
              <i class="fas fa-user-ninja text-primary"></i> ${displayName}
            </a>
            <a href="profile.html" title="View Profile (${displayName})">
              ${avatarHtml}
            </a>
            <button class="px-3 py-1.5 rounded-lg bg-surface-container-high hover:bg-surface-container border border-white/10 text-outline hover:text-white font-label-md text-xs font-semibold transition-all" onclick="handleLogout()">Logout</button>
          </div>
        `;
        if (drawerAuthHeader) {
          drawerAuthHeader.innerHTML = `
            <a href="profile.html" class="flex items-center gap-3 p-2.5 rounded-xl bg-white/5 border border-white/10 mb-3 text-decoration-none">
              ${avatarHtml}
              <div class="overflow-hidden truncate">
                <div class="font-headline-sm text-sm font-bold text-white truncate">${displayName}</div>
                <div class="font-label-sm text-xs text-outline truncate">${email}</div>
              </div>
            </a>
            <a href="profile.html" class="block py-2 text-sm text-white hover:text-secondary-container transition-colors"><i class="fas fa-user-ninja text-primary mr-2"></i> My Otaku Profile & Passport</a>
            ${role === 'ADMIN' ? `<a href="admin.html" class="block py-2 text-sm text-secondary hover:text-secondary-container transition-colors"><i class="fas fa-lock mr-2"></i> Admin Panel</a>` : ''}
            <button class="w-full mt-2 py-2 rounded-lg bg-surface-container-high hover:bg-surface-container border border-white/10 text-white font-label-md text-xs font-semibold transition-all" onclick="handleLogout()">Logout</button>
          `;
        }
      } else {
        authHeader.innerHTML = `<button class="px-4 py-2 rounded-lg bg-surface-container-high hover:bg-surface-container border border-white/10 text-white font-label-md text-sm font-semibold transition-all" onclick="window.location.href='login.html'">Sign In</button>`;
        if (drawerAuthHeader) {
          drawerAuthHeader.innerHTML = `<button class="w-full py-2.5 rounded-lg bg-primary-container text-white font-label-md text-sm font-bold shadow-[0_0_14px_rgba(255,0,85,0.4)] transition-all" onclick="window.location.href='login.html'">Sign In</button>`;
        }
      }
    }

    function handleLogout() {
      localStorage.clear();
      window.location.reload();
    }

    // Require Auth Play helper
    window.requireAuthPlay = function (e, playUrl) {
      const token = localStorage.getItem('infinx_token');
      if (!token) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        sessionStorage.setItem('infinx_redirect_after_auth', playUrl);
        window.location.href = 'login.html';
        return false;
      }
      if (playUrl && playUrl !== '#') {
        window.location.href = playUrl;
      }
      return true;
    };

    // Spotlight Hero (Featured Anime)
    async function initSpotlight() {
      try {
        const res = await fetch(`${API_BASE}/lunarx/trending`);
        if (!res.ok) return;
        const data = await res.json();
        const list = data.popularThisSeason || data.trendingNow || [];
        if (list.length === 0) return;

        const topAnime = list[0];
        const titleEl = document.getElementById('spotlightTitle');
        const backdropEl = document.getElementById('spotlightBackdrop');
        const playBtnEl = document.getElementById('spotlightPlayBtn');
        const infoBtnEl = document.getElementById('spotlightInfoBtn');

        if (titleEl) titleEl.textContent = topAnime.title;
        if (backdropEl && (topAnime.banner || topAnime.poster)) {
          backdropEl.src = topAnime.banner || topAnime.poster;
        }

        const playUrl = `/watch?id=${topAnime.anilistId}&ep=1`;
        if (playBtnEl) {
          playBtnEl.href = playUrl;
          playBtnEl.onclick = (e) => window.requireAuthPlay(e, playUrl);
        }

        if (infoBtnEl) {
          infoBtnEl.onclick = () => {
            if (window.openShowDetails) {
              window.openShowDetails({
                id: `lunar-${topAnime.anilistId}`,
                anilistId: topAnime.anilistId,
                title: topAnime.title,
                poster: topAnime.poster,
                banner: topAnime.banner,
                isLunar: true
              });
            }
          };
        }

        // Fetch detailed genres and description
        try {
          const infoRes = await fetch(`${API_BASE}/lunarx/info/${topAnime.anilistId}`);
          if (infoRes.ok) {
            const info = await infoRes.json();
            const ratingEl = document.getElementById('spotlightRating');
            const yearEl = document.getElementById('spotlightYear');
            const genresEl = document.getElementById('spotlightGenres');
            const descEl = document.getElementById('spotlightDesc');

            if (ratingEl && info.rating) ratingEl.innerHTML = `<i class="fas fa-star text-secondary-container"></i> ${info.rating}`;
            if (yearEl && info.year) yearEl.textContent = info.year;
            if (genresEl && info.genres && info.genres.length) genresEl.textContent = info.genres.slice(0, 3).join(', ');
            if (descEl && info.description) {
              const cleanDesc = info.description.replace(/<br\s*\/?>/gi, ' ').replace(/\s+/g, ' ').trim();
              descEl.textContent = cleanDesc;
            }
          }
        } catch (e) { }
      } catch (err) {
        console.warn('Failed to load spotlight anime:', err);
      }
    }

    // Load Catalog with current filters & pagination
    async function loadCatalog() {
      animeGrid.innerHTML = `
        <div class="col-span-full py-20 text-center text-outline font-body-md text-base">
          <div class="w-10 h-10 border-2 border-primary border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
          Syncing Neural Vault Transmission...
        </div>
      `;

      try {
        const params = new URLSearchParams({
          page: currentPage,
          limit: 24,
          sort: currentFilters.sort
        });

        if (currentFilters.search) params.append('search', currentFilters.search);
        if (currentFilters.genre && currentFilters.genre !== 'all') params.append('genre', currentFilters.genre);
        if (currentFilters.format && currentFilters.format !== 'all') params.append('format', currentFilters.format);
        if (currentFilters.season && currentFilters.season !== 'all') params.append('season', currentFilters.season);
        if (currentFilters.year && currentFilters.year !== 'all') params.append('year', currentFilters.year);
        if (currentFilters.status && currentFilters.status !== 'all') params.append('status', currentFilters.status);

        const res = await fetch(`${API_BASE}/lunarx/browse?${params.toString()}`);
        if (!res.ok) throw new Error(`API error ${res.status}`);
        const data = await res.json();

        const media = data.media || [];
        const pageInfo = data.pageInfo || {};
        totalPages = pageInfo.lastPage || Math.ceil((pageInfo.total || 0) / 24) || 1;

        if (resultsCountBadge) {
          resultsCountBadge.textContent = pageInfo.total
            ? `${pageInfo.total.toLocaleString()} anime master records found`
            : `${media.length} anime records`;
        }

        renderAnimeCards(media);
        updatePagination(pageInfo);
      } catch (err) {
        console.error('Catalog load error:', err);
        animeGrid.innerHTML = `
          <div class="col-span-full py-16 text-center text-error font-body-md text-sm">
            <i class="fas fa-exclamation-triangle text-2xl mb-2 block"></i>
            Transmission stream error. Please check your network connection.
          </div>
        `;
      }
    }

    // Render anime cards in grid
    function renderAnimeCards(list) {
      if (!list || list.length === 0) {
        animeGrid.innerHTML = `
          <div class="col-span-full py-20 text-center text-outline font-body-md text-sm">
            <span class="material-symbols-outlined text-4xl mb-2 block text-outline-variant">cloud_off</span>
            No anime records matched the specified filters. Try resetting search parameters.
          </div>
        `;
        return;
      }

      animeGrid.innerHTML = list.map(item => {
        const playUrl = `/watch?id=${item.anilistId}&ep=1`;
        const posterUrl = item.poster || 'Postes/spyfamS3p.jpg';
        const safeTitle = (item.title || '').replace(/'/g, "\\'");
        const safePoster = (item.poster || '').replace(/'/g, "\\'");
        const safeBanner = (item.banner || '').replace(/'/g, "\\'");
        const formatLabel = item.format ? item.format.replace('_', ' ') : 'TV';
        const epCount = item.episodes ? `EP ${item.episodes}` : 'SERIES';
        const primaryGenre = (item.genres && item.genres.length) ? item.genres[0] : (item.format || 'Anime');
        const rating = item.rating || '8.8';

        return `
          <div class="group relative flex flex-col rounded-xl overflow-hidden bg-surface-container-low border border-white/5 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_0_24px_rgba(0,240,255,0.4)]">
            <div class="relative w-full aspect-[2/3] overflow-hidden bg-surface-container-highest cursor-pointer" onclick="window.openShowDetails({ id: 'lunar-${item.anilistId}', anilistId: ${item.anilistId}, title: '${safeTitle}', poster: '${safePoster}', banner: '${safeBanner}', isLunar: true })">
              <img src="${posterUrl}" alt="${safeTitle}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" onerror="this.onerror=null; this.src='Postes/spyfamS3p.jpg';">
              <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/60 pointer-events-none"></div>

              <!-- Top Left Badges -->
              <div class="absolute top-2 left-2 flex flex-col gap-1 pointer-events-none">
                <span class="px-1.5 py-0.5 rounded bg-black/80 backdrop-blur-md font-label-sm text-[9px] text-primary font-bold tracking-wider uppercase shadow-sm">
                  ${epCount}
                </span>
                <span class="px-1.5 py-0.5 rounded bg-black/80 backdrop-blur-md font-label-sm text-[9px] text-secondary font-bold tracking-wider uppercase shadow-sm">
                  1080P OLED
                </span>
              </div>

              <!-- Top Right Rating Badge -->
              <div class="absolute top-2 right-2 pointer-events-none">
                <span class="px-1.5 py-0.5 rounded bg-black/80 backdrop-blur-md font-label-sm text-[9px] text-secondary-container font-extrabold flex items-center gap-0.5">
                  ★ ${rating}
                </span>
              </div>

              <!-- Bottom Left Format Badge -->
              <div class="absolute bottom-2 left-2 pointer-events-none">
                <span class="px-1.5 py-0.5 rounded bg-surface-container-high/80 font-label-sm text-[9px] text-on-surface-variant uppercase tracking-widest font-bold">
                  ${formatLabel}
                </span>
              </div>

              <!-- Hover Action Overlay -->
              <div class="absolute inset-0 bg-black/85 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex flex-col items-center justify-center p-3 gap-2">
                <button
                  class="w-full py-2 rounded-lg bg-primary-container text-white font-label-md text-xs uppercase tracking-wider font-bold shadow-[0_0_18px_rgba(255,0,85,0.6)] hover:brightness-110 active:scale-95 transition-all flex items-center justify-center gap-1.5"
                  onclick="event.stopPropagation(); return window.requireAuthPlay(event, '${playUrl}')">
                  <span class="material-symbols-outlined text-[16px]">play_arrow</span>
                  Play Stream
                </button>
                <div class="flex items-center gap-1.5 w-full">
                  <button
                    class="flex-1 py-1.5 rounded bg-surface-container-high text-on-surface hover:text-secondary-container hover:bg-surface-container font-label-sm text-[11px] uppercase tracking-wider font-semibold flex items-center justify-center gap-1 transition-all"
                    onclick="event.stopPropagation(); window.toggleAnimeWatchlist('${item.anilistId}', '${safeTitle}', '${safePoster}')"
                    title="Add to Watchlist">
                    <span class="material-symbols-outlined text-[14px]">bookmark_add</span> Queue
                  </button>
                  <button
                    class="p-1.5 rounded bg-surface-container-high text-on-surface hover:text-primary transition-colors"
                    title="Quick Detail Preview"
                    onclick="event.stopPropagation(); window.openShowDetails({ id: 'lunar-${item.anilistId}', anilistId: ${item.anilistId}, title: '${safeTitle}', poster: '${safePoster}', banner: '${safeBanner}', isLunar: true })">
                    <span class="material-symbols-outlined text-[14px]">info</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Card Body Info -->
            <div class="p-2.5 flex flex-col gap-1 cursor-pointer" onclick="window.openShowDetails({ id: 'lunar-${item.anilistId}', anilistId: ${item.anilistId}, title: '${safeTitle}', poster: '${safePoster}', banner: '${safeBanner}', isLunar: true })">
              <h3 class="font-headline-sm text-sm font-bold text-on-surface truncate group-hover:text-secondary-container transition-colors" title="${item.title}">
                ${item.title}
              </h3>
              <div class="flex items-center justify-between text-outline font-label-sm text-[11px]">
                <span>${item.year || '2026'} • ${primaryGenre}</span>
                <span class="text-secondary font-semibold">SUB • DUB</span>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Quick Watchlist Toggle from Card
    window.toggleAnimeWatchlist = async function (anilistId, title, poster) {
      const token = localStorage.getItem('infinx_token');
      if (!token) {
        window.location.href = 'login.html';
        return;
      }

      try {
        const showId = `lunar-${anilistId}`;
        const res = await fetch(`${API_BASE}/user/watchlist`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ showId, title, poster })
        });
        if (res.ok) {
          const toast = document.createElement('div');
          toast.className = 'fixed bottom-20 right-6 z-50 px-4 py-2 rounded-xl bg-surface-container-high border border-secondary-container/40 text-secondary-container font-label-md text-xs shadow-2xl flex items-center gap-2';
          toast.innerHTML = `<span class="material-symbols-outlined text-[16px]">check_circle</span> Updated transmission queue`;
          document.body.appendChild(toast);
          setTimeout(() => toast.remove(), 2500);
        }
      } catch (e) {
        console.warn('Watchlist toggle err:', e);
      }
    };

    // Update Pagination UI
    function updatePagination(pageInfo) {
      if (pageIndicator) pageIndicator.textContent = `Page ${currentPage} of ${totalPages || 1}`;
      if (prevPageBtn) prevPageBtn.disabled = currentPage <= 1;
      if (nextPageBtn) nextPageBtn.disabled = !pageInfo.hasNextPage && currentPage >= totalPages;

      const telemetryEl = document.getElementById('paginationTelemetry');
      if (telemetryEl) {
        const start = ((currentPage - 1) * 24) + 1;
        const total = pageInfo.total || 0;
        const end = Math.min(currentPage * 24, total || (currentPage * 24));
        telemetryEl.textContent = `Displaying records ${start}–${end} of ${total.toLocaleString()}`;
      }

      if (jumpInput) {
        jumpInput.max = totalPages || 1;
      }
    }

    // Pagination Click Handlers
    if (prevPageBtn) {
      prevPageBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          loadCatalog();
          window.scrollTo({ top: 400, behavior: 'smooth' });
        }
      });
    }

    if (nextPageBtn) {
      nextPageBtn.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          loadCatalog();
          window.scrollTo({ top: 400, behavior: 'smooth' });
        }
      });
    }

    if (jumpBtn && jumpInput) {
      jumpBtn.addEventListener('click', () => {
        const val = parseInt(jumpInput.value);
        if (val && val >= 1 && val <= totalPages) {
          currentPage = val;
          loadCatalog();
          window.scrollTo({ top: 400, behavior: 'smooth' });
        }
      });
    }

    // Setup Quick Tab Pills
    document.querySelectorAll('.tab-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-pill').forEach(b => {
          b.className = 'tab-pill flex-shrink-0 px-3.5 py-1.5 rounded-full font-label-md text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-white hover:bg-surface-container transition-all';
        });
        btn.className = 'tab-pill active flex-shrink-0 px-4 py-1.5 rounded-full font-label-md text-xs uppercase tracking-wider bg-primary-container text-white shadow-[0_0_18px_rgba(255,0,85,0.6)] font-bold transition-all';

        const tab = btn.getAttribute('data-tab');
        currentTab = tab;
        currentPage = 1;

        if (tab === 'trending') {
          currentFilters.sort = 'TRENDING_DESC';
          currentFilters.format = 'all';
          currentFilters.status = 'all';
          catalogSectionTitle.innerHTML = `<i class="fas fa-fire text-primary"></i> <span>Trending Anime</span>`;
        } else if (tab === 'popular') {
          currentFilters.sort = 'POPULARITY_DESC';
          currentFilters.format = 'all';
          currentFilters.status = 'all';
          catalogSectionTitle.innerHTML = `<i class="fas fa-crown text-[#ffaa00]"></i> <span>Popular This Season</span>`;
        } else if (tab === 'top-rated') {
          currentFilters.sort = 'SCORE_DESC';
          currentFilters.format = 'all';
          currentFilters.status = 'all';
          catalogSectionTitle.innerHTML = `<i class="fas fa-star text-secondary-container"></i> <span>Top Rated of All Time</span>`;
        } else if (tab === 'upcoming') {
          currentFilters.sort = 'POPULARITY_DESC';
          currentFilters.status = 'NOT_YET_RELEASED';
          catalogSectionTitle.innerHTML = `<i class="fas fa-calendar-alt text-tertiary"></i> <span>Upcoming Next Season</span>`;
        } else if (tab === 'movies') {
          currentFilters.sort = 'POPULARITY_DESC';
          currentFilters.format = 'MOVIE';
          currentFilters.status = 'all';
          catalogSectionTitle.innerHTML = `<i class="fas fa-film text-[#00ff88]"></i> <span>Anime Movies</span>`;
        }

        const sortFilter = document.getElementById('sortFilter');
        const formatFilter = document.getElementById('formatFilter');
        if (sortFilter) sortFilter.value = currentFilters.sort;
        if (formatFilter) formatFilter.value = currentFilters.format;

        loadCatalog();
      });
    });

    // Setup Filter Listeners
    function setupFilterListeners() {
      let searchTimeout = null;
      const catalogSearchInput = document.getElementById('catalogSearchInput');
      const catalogExecuteBtn = document.getElementById('catalogExecuteBtn');

      if (catalogSearchInput) {
        catalogSearchInput.addEventListener('input', function () {
          clearTimeout(searchTimeout);
          currentFilters.search = this.value.trim();
          searchTimeout = setTimeout(() => {
            currentPage = 1;
            loadCatalog();
          }, 300);
        });

        catalogSearchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            catalogSearchInput.value = '';
            currentFilters.search = '';
            currentPage = 1;
            loadCatalog();
            catalogSearchInput.blur();
          } else if (e.key === 'Enter') {
            currentFilters.search = catalogSearchInput.value.trim();
            currentPage = 1;
            loadCatalog();
          }
        });
      }

      if (catalogExecuteBtn && catalogSearchInput) {
        catalogExecuteBtn.addEventListener('click', () => {
          currentFilters.search = catalogSearchInput.value.trim();
          currentPage = 1;
          loadCatalog();
        });
      }

      // Rapid Vector Tags
      document.querySelectorAll('.rapid-tag').forEach(tagBtn => {
        tagBtn.addEventListener('click', () => {
          const tag = tagBtn.getAttribute('data-tag');
          if (tag) {
            currentFilters.genre = tag;
            currentPage = 1;
            highlightGenrePill(tag);
            loadCatalog();
          }
        });
      });

      // Genre Pills
      document.querySelectorAll('.genre-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          const genre = pill.getAttribute('data-genre') || 'all';
          currentFilters.genre = genre;
          currentPage = 1;

          document.querySelectorAll('.genre-pill').forEach(p => {
            p.className = 'genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all';
          });
          pill.className = 'genre-pill flex-shrink-0 px-3.5 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-secondary-container text-black font-bold shadow-[0_0_14px_rgba(0,240,255,0.4)] transition-all';

          const genreFilter = document.getElementById('genreFilter');
          if (genreFilter) genreFilter.value = genre;

          loadCatalog();
        });
      });

      function highlightGenrePill(genreName) {
        document.querySelectorAll('.genre-pill').forEach(p => {
          if (p.getAttribute('data-genre') === genreName) {
            p.className = 'genre-pill flex-shrink-0 px-3.5 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-secondary-container text-black font-bold shadow-[0_0_14px_rgba(0,240,255,0.4)] transition-all';
          } else {
            p.className = 'genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all';
          }
        });
      }

      // Season Selector Pills
      document.querySelectorAll('.season-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          const s = pill.getAttribute('data-season') || 'all';
          const y = pill.getAttribute('data-year') || 'all';
          currentFilters.season = s;
          currentFilters.year = y;
          currentPage = 1;

          document.querySelectorAll('.season-pill').forEach(p => {
            p.className = 'season-pill px-2.5 py-1 rounded font-label-sm text-[11px] tracking-wider uppercase text-outline hover:text-white hover:bg-surface-container transition-all';
          });
          pill.className = 'season-pill px-2.5 py-1 rounded font-label-sm text-[11px] tracking-wider uppercase bg-secondary-container/20 text-secondary-container shadow-[0_0_10px_rgba(0,240,255,0.3)] font-bold';

          const seasonFilter = document.getElementById('seasonFilter');
          const yearFilter = document.getElementById('yearFilter');
          if (seasonFilter) seasonFilter.value = s;
          if (yearFilter) yearFilter.value = y;

          loadCatalog();
        });
      });

      // A-Z Bar
      document.querySelectorAll('.az-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const letter = btn.getAttribute('data-letter') || 'all';
          document.querySelectorAll('.az-btn').forEach(b => {
            b.className = 'az-btn px-1.5 py-0.5 rounded text-outline hover:text-secondary-container hover:bg-surface-container transition-all';
          });
          btn.className = 'az-btn px-2 py-0.5 rounded bg-secondary-container text-black font-bold shadow-[0_0_8px_rgba(0,240,255,0.4)]';

          if (letter === 'all') {
            currentFilters.search = '';
            if (catalogSearchInput) catalogSearchInput.value = '';
          } else {
            currentFilters.search = letter;
            if (catalogSearchInput) catalogSearchInput.value = letter;
          }
          currentPage = 1;
          loadCatalog();
        });
      });

      // Dropdown Select Listeners
      const formatFilter = document.getElementById('formatFilter');
      if (formatFilter) {
        formatFilter.addEventListener('change', function () {
          currentFilters.format = this.value;
          currentPage = 1;
          loadCatalog();
        });
      }

      const seasonFilter = document.getElementById('seasonFilter');
      if (seasonFilter) {
        seasonFilter.addEventListener('change', function () {
          currentFilters.season = this.value;
          currentPage = 1;
          loadCatalog();
        });
      }

      const yearFilter = document.getElementById('yearFilter');
      if (yearFilter) {
        yearFilter.addEventListener('change', function () {
          currentFilters.year = this.value;
          currentPage = 1;
          loadCatalog();
        });
      }

      const statusFilter = document.getElementById('statusFilter');
      if (statusFilter) {
        statusFilter.addEventListener('change', function () {
          currentFilters.status = this.value;
          currentPage = 1;
          loadCatalog();
        });
      }

      const sortFilter = document.getElementById('sortFilter');
      if (sortFilter) {
        sortFilter.addEventListener('change', function () {
          currentFilters.sort = this.value;
          currentPage = 1;
          loadCatalog();
        });
      }

      // Reset Button
      const resetFiltersBtn = document.getElementById('resetFiltersBtn');
      if (resetFiltersBtn) {
        resetFiltersBtn.addEventListener('click', () => {
          currentFilters = {
            search: '',
            genre: 'all',
            format: 'all',
            season: 'all',
            year: 'all',
            status: 'all',
            sort: 'TRENDING_DESC'
          };

          if (catalogSearchInput) catalogSearchInput.value = '';
          if (formatFilter) formatFilter.value = 'all';
          if (seasonFilter) seasonFilter.value = 'all';
          if (yearFilter) yearFilter.value = 'all';
          if (statusFilter) statusFilter.value = 'all';
          if (sortFilter) sortFilter.value = 'TRENDING_DESC';

          // Reset Tab Pills
          document.querySelectorAll('.tab-pill').forEach(b => {
            b.className = 'tab-pill flex-shrink-0 px-3.5 py-1.5 rounded-full font-label-md text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-white hover:bg-surface-container transition-all';
          });
          const firstTab = document.querySelector('.tab-pill[data-tab="trending"]');
          if (firstTab) firstTab.className = 'tab-pill active flex-shrink-0 px-4 py-1.5 rounded-full font-label-md text-xs uppercase tracking-wider bg-primary-container text-white shadow-[0_0_18px_rgba(255,0,85,0.6)] font-bold transition-all';
          if (catalogSectionTitle) catalogSectionTitle.innerHTML = `<i class="fas fa-fire text-primary"></i> <span>Trending Anime</span>`;

          // Reset Genre Pills
          highlightGenrePill('all');

          // Reset A-Z
          document.querySelectorAll('.az-btn').forEach(b => {
            b.className = 'az-btn px-1.5 py-0.5 rounded text-outline hover:text-secondary-container hover:bg-surface-container transition-all';
          });
          const azAll = document.querySelector('.az-btn[data-letter="all"]');
          if (azAll) azAll.className = 'az-btn px-2 py-0.5 rounded bg-secondary-container text-black font-bold shadow-[0_0_8px_rgba(0,240,255,0.4)]';

          currentPage = 1;
          loadCatalog();
        });
      }
    }

    // View Switcher (Grid vs List Layout)
    function setupLayoutSwitcher() {
      const gridBtn = document.getElementById('viewGridBtn');
      const listBtn = document.getElementById('viewListBtn');

      if (gridBtn && listBtn && animeGrid) {
        gridBtn.addEventListener('click', () => {
          gridBtn.className = 'p-1.5 rounded bg-secondary-container/20 text-secondary-container shadow-[0_0_8px_rgba(0,240,255,0.3)] transition-all';
          listBtn.className = 'p-1.5 rounded text-outline hover:text-white hover:bg-surface-container-high transition-all';
          animeGrid.className = 'grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4';
        });

        listBtn.addEventListener('click', () => {
          listBtn.className = 'p-1.5 rounded bg-secondary-container/20 text-secondary-container shadow-[0_0_8px_rgba(0,240,255,0.3)] transition-all';
          gridBtn.className = 'p-1.5 rounded text-outline hover:text-white hover:bg-surface-container-high transition-all';
          animeGrid.className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4';
        });
      }
    }

    // Live Auto-Suggest Header Search
    function setupSearchListeners() {
      const searchInput = document.getElementById('searchInput');
      const liveDropdown = document.getElementById('liveSearchDropdown');
      let searchDebounce = null;

      async function performLiveSearch(query, targetContainer) {
        if (!query || query.length < 2) {
          targetContainer.innerHTML = '';
          targetContainer.style.display = 'none';
          return;
        }

        try {
          const res = await fetch(`${API_BASE}/shows/search?q=${encodeURIComponent(query)}`);
          if (!res.ok) return;
          const results = await res.json();

          if (!results || results.length === 0) {
            targetContainer.innerHTML = `
              <div class="p-4 text-center text-outline text-xs">
                No anime records found for "${query}"
              </div>
            `;
            targetContainer.style.display = 'block';
            return;
          }

          const itemsHtml = results.slice(0, 7).map(item => {
            const posterUrl = (item.poster && (item.poster.startsWith('http://') || item.poster.startsWith('https://')))
              ? item.poster
              : window.formatMediaUrl(item.poster);
            const isAnime = item.isLunar || (typeof item.id === 'string' && item.id.startsWith('lunar-')) || item.anilistId;
            const badge = isAnime ? 'Anime' : (item.badge || 'HD');
            const anilistId = item.anilistId || (typeof item.id === 'string' ? item.id.replace('lunar-', '') : item.id);
            const safeTitle = (item.title || '').replace(/'/g, "\\'");
            const safePoster = (item.poster || '').replace(/'/g, "\\'");
            const safeBanner = (item.banner || '').replace(/'/g, "\\'");

            return `
              <div class="live-search-item" onclick="if(window.openShowDetails) window.openShowDetails({ id: '${item.id}', anilistId: ${anilistId || 'null'}, title: '${safeTitle}', poster: '${safePoster}', banner: '${safeBanner}', isLunar: ${isAnime ? 'true' : 'false'} })">
                <img src="${posterUrl}" alt="${item.title}" class="live-search-thumb" onerror="this.src='Postes/spyfamS3p.jpg';">
                <div class="live-search-info">
                  <div class="live-search-title">${item.title}</div>
                  <div class="live-search-meta">
                    <span class="text-secondary-container font-semibold"><i class="fas fa-star text-[10px]"></i> ${item.rating || '4.9'}</span>
                    <span>•</span>
                    <span>${item.year || '2024'}</span>
                    <span class="live-search-badge">${badge}</span>
                  </div>
                </div>
              </div>
            `;
          }).join('');

          targetContainer.innerHTML = `
            ${itemsHtml}
            <div class="live-search-footer" onclick="window.location.href='view.html#search?q=${encodeURIComponent(query)}'">
              View all results for "${query}" <i class="fas fa-arrow-right ml-1"></i>
            </div>
          `;
          targetContainer.style.display = 'block';
        } catch (err) {
          console.warn('Live search error:', err);
        }
      }

      if (searchInput && liveDropdown) {
        searchInput.addEventListener('input', function () {
          clearTimeout(searchDebounce);
          const term = this.value.trim();
          searchDebounce = setTimeout(() => {
            performLiveSearch(term, liveDropdown);
          }, 220);
        });

        searchInput.addEventListener('keyup', function (e) {
          if (e.key === 'Enter') {
            const term = this.value.trim();
            if (term) {
              liveDropdown.style.display = 'none';
              window.location.href = `view.html#search?q=${encodeURIComponent(term)}`;
            }
          }
        });

        document.addEventListener('click', function (e) {
          if (!searchInput.contains(e.target) && !liveDropdown.contains(e.target)) {
            liveDropdown.style.display = 'none';
          }
        });
      }

      // Mobile search overlay
      const tabSearch = document.getElementById('tabSearch');
      const mobileHeaderSearchBtn = document.getElementById('mobileHeaderSearchBtn');
      const mobileSearchOverlay = document.getElementById('mobileSearchOverlay');
      const closeSearchOverlay = document.getElementById('closeSearchOverlay');
      const mobileSearchInput = document.getElementById('mobileSearchInput');
      const mobileSearchResults = document.getElementById('mobileSearchResults');

      const openMobileSearch = (e) => {
        if (e) e.preventDefault();
        if (mobileSearchOverlay) {
          mobileSearchOverlay.classList.add('active');
          if (mobileSearchInput) {
            setTimeout(() => mobileSearchInput.focus(), 60);
          }
        }
      };

      if (tabSearch) tabSearch.addEventListener('click', openMobileSearch);
      if (mobileHeaderSearchBtn) mobileHeaderSearchBtn.addEventListener('click', openMobileSearch);

      if (closeSearchOverlay && mobileSearchOverlay) {
        closeSearchOverlay.addEventListener('click', () => {
          mobileSearchOverlay.classList.remove('active');
        });
      }

      if (mobileSearchInput && mobileSearchResults) {
        mobileSearchInput.addEventListener('input', function () {
          clearTimeout(searchDebounce);
          const q = this.value.trim();
          searchDebounce = setTimeout(() => {
            performLiveSearch(q, mobileSearchResults);
          }, 220);
        });

        mobileSearchInput.addEventListener('keyup', function (e) {
          if (e.key === 'Enter') {
            const term = this.value.trim();
            if (term) {
              if (mobileSearchOverlay) mobileSearchOverlay.classList.remove('active');
              window.location.href = `view.html#search?q=${encodeURIComponent(term)}`;
            }
          }
        });
      }
    }

    // Mobile Menu Drawer Setup
    function setupMobileMenu() {
      const toggle = document.getElementById('mobileMenuToggle');
      const navbar = document.getElementById('mainNavbar');
      const closeBtn = document.getElementById('closeDrawer');
      const navOverlay = document.getElementById('navOverlay');

      const openDrawer = () => {
        navbar?.classList.add('active');
        navbar?.classList.remove('translate-x-full');
        navOverlay?.classList.add('opacity-100', 'pointer-events-auto');
        navOverlay?.classList.remove('opacity-0', 'pointer-events-none');
        document.body.style.overflow = 'hidden';
      };

      const closeDrawer = () => {
        navbar?.classList.remove('active');
        navbar?.classList.add('translate-x-full');
        navOverlay?.classList.remove('opacity-100', 'pointer-events-auto');
        navOverlay?.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      };

      if (toggle) toggle.addEventListener('click', openDrawer);
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      if (navOverlay) navOverlay.addEventListener('click', closeDrawer);

      document.querySelectorAll('#mainNavbar .nav-link').forEach(link => {
        link.addEventListener('click', closeDrawer);
      });
    }

    // Dropdown Toggles
    document.querySelectorAll('.dropdown-toggle').forEach(btn => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const parent = this.closest('.nav-item-dropdown');
        if (parent) {
          const wasActive = parent.classList.contains('active');
          document.querySelectorAll('.nav-item-dropdown').forEach(d => d.classList.remove('active'));
          if (!wasActive) parent.classList.add('active');
        }
      });
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.nav-item-dropdown')) {
        document.querySelectorAll('.nav-item-dropdown').forEach(d => d.classList.remove('active'));
      }
    });

    window.openLogin = () => { window.location.href = 'login.html'; };
  </script>

  <!-- Modal Script & Cinematic Welcome Engine -->
  <script src="navbar.js"></script>
  <script src="/show-details-modal.js"></script>
  <script src="welcome.js"></script>

</body>

</html>