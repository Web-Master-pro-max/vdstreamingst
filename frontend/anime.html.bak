            </button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Action">Action</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Adventure">Adventure</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Comedy">Comedy</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Drama">Drama</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Fantasy">Fantasy</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Romance">Romance</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Sci-Fi">Sci-Fi</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Supernatural">Supernatural</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Mystery">Mystery</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Slice of Life">Slice of Life</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Sports">Sports</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Thriller">Thriller</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Horror">Horror</button>
            <button
              class="genre-pill flex-shrink-0 px-3 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-genre="Psychological">Psychological</button>
          </div>

          <!-- Row 3: A-Z Alphabet Quick Jump Index -->
          <div
            class="flex items-center justify-between gap-1 overflow-x-auto no-scrollbar py-1 border-t border-white/5 font-label-sm text-xs"
            id="azBar">
            <span class="text-outline uppercase text-[10px] tracking-widest font-bold mr-1 flex-shrink-0">INDEX:</span>
            <button
              class="az-btn px-2 py-0.5 rounded bg-secondary-container text-black font-bold shadow-[0_0_8px_rgba(0,240,255,0.4)]"
              data-letter="all">ALL</button>
            <button
              class="az-btn px-1.5 py-0.5 rounded text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-letter="#">#</button>
            <button
              class="az-btn px-1.5 py-0.5 rounded text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-letter="A">A</button>
            <button
              class="az-btn px-1.5 py-0.5 rounded text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-letter="B">B</button>
            <button
              class="az-btn px-1.5 py-0.5 rounded text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-letter="C">C</button>
