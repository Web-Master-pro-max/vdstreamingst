            </button>
          </div>

          <!-- Quick Jump Input -->
          <div class="flex items-center gap-2">
            <label class="font-label-sm text-xs text-outline uppercase tracking-wider" for="jumpInput">Jump:</label>
            <div class="relative flex items-center">
