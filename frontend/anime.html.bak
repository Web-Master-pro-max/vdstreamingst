              </button>
            </div>

          </div>

          <!-- Row 2: Genre Pills Carousel -->
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5" id="genrePillsContainer">
            <button
              class="genre-pill flex-shrink-0 px-3.5 py-1 rounded-full font-label-sm text-xs uppercase tracking-wider bg-secondary-container text-black font-bold shadow-[0_0_14px_rgba(0,240,255,0.4)] transition-all"
              data-genre="all">
