            </button>

            <span
              class="px-4 py-1.5 rounded-lg bg-surface-container-high border border-white/10 font-label-md text-xs font-bold text-white tracking-wider"
              id="pageIndicator">Page 1</span>

            <button
              class="px-4 py-2 rounded-lg bg-surface-container text-white hover:text-secondary-container hover:bg-surface-container-high font-label-md text-xs font-semibold flex items-center gap-1.5 border border-white/5 transition-all shadow-md"
              id="nextPageBtn">
              <span>Next</span>
