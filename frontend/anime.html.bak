      <!-- ==================== STICKY CYBERNETIC FILTER MATRIX & CONTROLS ==================== -->
      <section
        class="sticky top-20 z-40 w-full bg-black/95 backdrop-blur-2xl py-3 px-4 sm:px-6 lg:px-8 border-b border-white/10 shadow-[0_12px_36px_rgba(0,0,0,0.85)]">
        <div class="max-w-7xl mx-auto flex flex-col gap-2.5">

          <!-- Row 1: Quick Feeds Tabs & Season Select -->
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">

            <!-- Quick Feeds Tabs Bar -->
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 lg:pb-0" id="animeTabsBar">
              <button
                class="tab-pill active flex-shrink-0 px-4 py-1.5 rounded-full font-label-md text-xs uppercase tracking-wider bg-primary-container text-white shadow-[0_0_18px_rgba(255,0,85,0.6)] font-bold transition-all"
                data-tab="trending">
                <i class="fas fa-fire mr-1"></i> Trending Now
              </button>
              <button
                class="tab-pill flex-shrink-0 px-3.5 py-1.5 rounded-full font-label-md text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-white hover:bg-surface-container transition-all"
                data-tab="popular">
                <i class="fas fa-crown mr-1"></i> Popular This Season
              </button>
              <button
                class="tab-pill flex-shrink-0 px-3.5 py-1.5 rounded-full font-label-md text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-white hover:bg-surface-container transition-all"
                data-tab="top-rated">
                <i class="fas fa-star mr-1"></i> Top Rated
              </button>
              <button
                class="tab-pill flex-shrink-0 px-3.5 py-1.5 rounded-full font-label-md text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-white hover:bg-surface-container transition-all"
                data-tab="upcoming">
                <i class="fas fa-calendar-alt mr-1"></i> Upcoming
              </button>
              <button
                class="tab-pill flex-shrink-0 px-3.5 py-1.5 rounded-full font-label-md text-xs uppercase tracking-wider bg-surface-container-high/80 text-outline hover:text-white hover:bg-surface-container transition-all"
                data-tab="movies">
                <i class="fas fa-film mr-1"></i> Movies
              </button>
            </div>

            <!-- Season Selector Pills -->
            <div
              class="flex items-center gap-1 bg-surface-container-high/70 border border-white/5 p-1 rounded-lg flex-shrink-0 overflow-x-auto no-scrollbar"
              id="seasonPills">
              <span class="material-symbols-outlined text-outline text-[16px] ml-1 mr-0.5">calendar_month</span>
              <button
                class="season-pill px-2.5 py-1 rounded font-label-sm text-[11px] tracking-wider uppercase bg-secondary-container/20 text-secondary-container shadow-[0_0_10px_rgba(0,240,255,0.3)] font-bold"
                data-season="all" data-year="all">
                All Time
              </button>
              <button
                class="season-pill px-2.5 py-1 rounded font-label-sm text-[11px] tracking-wider uppercase text-outline hover:text-white hover:bg-surface-container transition-all"
                data-season="WINTER" data-year="2026">
                Winter 2026
              </button>
              <button
                class="season-pill px-2.5 py-1 rounded font-label-sm text-[11px] tracking-wider uppercase text-outline hover:text-white hover:bg-surface-container transition-all"
                data-season="SPRING" data-year="2026">
                Spring 2026
