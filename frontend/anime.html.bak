            <!-- Bitstream Telemetry Badge -->
            <div
              class="flex items-center gap-2 font-label-sm text-xs text-secondary-container bg-surface-container-low px-3 py-1 rounded-full border border-secondary-container/20">
              <span class="inline-block w-2 h-2 rounded-full bg-secondary-container animate-ping"></span>
              <span>4K REMASTER BITSTREAM STABLE</span>
            </div>
          </div>

          <!-- Anime Card Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4" id="animeGrid">
            <!-- Dynamically populated via loadCatalog() -->
          </div>

        </div>
      </section>

      <!-- ==================== CYBERPUNK PAGINATION BAR ==================== -->
      <section class="w-full px-4 sm:px-6 lg:px-8 py-8 border-t border-white/5 bg-black" id="paginationRow">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">

          <!-- Status Indicator -->
          <div class="flex items-center gap-2 font-body-sm text-xs text-outline">
            <span class="w-2 h-2 rounded-full bg-secondary-container"></span>
            <span id="paginationTelemetry">Navigating neural archive records</span>
          </div>

          <!-- Pagination Buttons -->
          <div class="flex items-center gap-2">
            <button
              class="px-4 py-2 rounded-lg bg-surface-container text-outline hover:text-white hover:bg-surface-container-high disabled:opacity-30 disabled:pointer-events-none font-label-md text-xs font-semibold flex items-center gap-1.5 border border-white/5 transition-all"
              id="prevPageBtn" disabled>
