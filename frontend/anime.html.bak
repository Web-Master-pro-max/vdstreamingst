            <button
              class="az-btn px-1.5 py-0.5 rounded text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-letter="Y">Y</button>
            <button
              class="az-btn px-1.5 py-0.5 rounded text-outline hover:text-secondary-container hover:bg-surface-container transition-all"
              data-letter="Z">Z</button>
          </div>

          <!-- Row 4: Secondary Filter Selects, Reset, View Switcher -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-1 border-t border-white/5">
            <div class="flex flex-wrap items-center gap-2">

              <!-- Format Select -->
              <div class="relative">
                <select
                  class="appearance-none bg-surface-container border border-white/10 text-on-surface font-label-md text-xs pl-3 pr-7 py-1.5 rounded-lg focus:outline-none focus:ring-1 focus:ring-secondary-container cursor-pointer shadow-sm"
                  id="formatFilter">
                  <option value="all">All Formats</option>
                  <option value="TV">TV Series</option>
                  <option value="MOVIE">Movie</option>
                  <option value="OVA">OVA</option>
                  <option value="SPECIAL">Special</option>
                </select>
                <i
                  class="fas fa-chevron-down absolute right-2 top-2.5 text-[10px] text-outline pointer-events-none"></i>
              </div>

              <!-- Season Select -->
              <div class="relative">
                <select
                  class="appearance-none bg-surface-container border border-white/10 text-on-surface font-label-md text-xs pl-3 pr-7 py-1.5 rounded-lg focus:outline-none focus:ring-1 focus:ring-secondary-container cursor-pointer shadow-sm"
                  id="seasonFilter">
                  <option value="all">All Seasons</option>
                  <option value="WINTER">Winter</option>
                  <option value="SPRING">Spring</option>
                  <option value="SUMMER">Summer</option>
                  <option value="FALL">Fall</option>
                </select>
                <i
                  class="fas fa-chevron-down absolute right-2 top-2.5 text-[10px] text-outline pointer-events-none"></i>
              </div>

              <!-- Year Select -->
              <div class="relative">
                <select
                  class="appearance-none bg-surface-container border border-white/10 text-on-surface font-label-md text-xs pl-3 pr-7 py-1.5 rounded-lg focus:outline-none focus:ring-1 focus:ring-secondary-container cursor-pointer shadow-sm"
                  id="yearFilter">
                  <option value="all">All Years</option>
                  <option value="2026">2026</option>
                  <option value="2025">2025</option>
                  <option value="2024">2024</option>
                  <option value="2023">2023</option>
                  <option value="2022">2022</option>
                  <option value="2021">2021</option>
                  <option value="2020">2020</option>
                </select>
                <i
                  class="fas fa-chevron-down absolute right-2 top-2.5 text-[10px] text-outline pointer-events-none"></i>
              </div>

              <!-- Status Select -->
              <div class="relative">
                <select
                  class="appearance-none bg-surface-container border border-white/10 text-on-surface font-label-md text-xs pl-3 pr-7 py-1.5 rounded-lg focus:outline-none focus:ring-1 focus:ring-secondary-container cursor-pointer shadow-sm"
                  id="statusFilter">
                  <option value="all">All Status</option>
                  <option value="RELEASING">Releasing</option>
                  <option value="FINISHED">Finished</option>
                  <option value="NOT_YET_RELEASED">Upcoming</option>
                </select>
                <i
                  class="fas fa-chevron-down absolute right-2 top-2.5 text-[10px] text-outline pointer-events-none"></i>
              </div>

              <!-- Hidden backing genre select for backward parity -->
              <select class="hidden" id="genreFilter">
                <option value="all">All Genres</option>
                <option value="Action">Action</option>
                <option value="Adventure">Adventure</option>
                <option value="Comedy">Comedy</option>
                <option value="Drama">Drama</option>
                <option value="Fantasy">Fantasy</option>
                <option value="Romance">Romance</option>
                <option value="Sci-Fi">Sci-Fi</option>
                <option value="Supernatural">Supernatural</option>
                <option value="Mystery">Mystery</option>
                <option value="Slice of Life">Slice of Life</option>
                <option value="Sports">Sports</option>
                <option value="Thriller">Thriller</option>
                <option value="Horror">Horror</option>
                <option value="Psychological">Psychological</option>
              </select>

              <!-- Reset Filters Button -->
              <button
                class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-high border border-white/10 text-outline hover:text-white font-label-sm text-xs font-semibold flex items-center gap-1.5 transition-all"
                id="resetFiltersBtn">
                <i class="fas fa-rotate-right text-[11px]"></i> Reset
              </button>
            </div>

            <!-- Right Controls: Sort & Layout Switcher -->
            <div class="flex items-center gap-3 ml-auto">
              <!-- Sort Dropdown -->
              <div class="flex items-center gap-2">
                <span class="font-label-sm text-xs text-outline uppercase tracking-wider hidden sm:inline">Sort:</span>
                <div class="relative">
                  <select
                    class="appearance-none bg-surface-container border border-white/10 text-on-surface font-label-md text-xs pl-3 pr-7 py-1.5 rounded-lg focus:outline-none focus:ring-1 focus:ring-secondary-container cursor-pointer shadow-md"
                    id="sortFilter">
                    <option value="TRENDING_DESC" selected>★ Trending</option>
                    <option value="POPULARITY_DESC">Most Popular</option>
                    <option value="SCORE_DESC">Highest Rated</option>
                    <option value="START_DATE_DESC">Newest Airing</option>
                  </select>
                  <i
                    class="fas fa-chevron-down absolute right-2 top-2.5 text-[10px] text-outline pointer-events-none"></i>
                </div>
              </div>

              <!-- View Switcher (Grid vs Dense List) -->
              <div class="flex items-center bg-surface-container border border-white/10 p-0.5 rounded-lg gap-0.5">
                <button
                  class="p-1.5 rounded bg-secondary-container/20 text-secondary-container shadow-[0_0_8px_rgba(0,240,255,0.3)] transition-all"
                  id="viewGridBtn" title="6-Column Poster Grid">
                  <span class="material-symbols-outlined text-[18px]">grid_view</span>
                </button>
                <button
                  class="p-1.5 rounded text-outline hover:text-white hover:bg-surface-container-high transition-all"
                  id="viewListBtn" title="Dense Telemetry List">
                  <span class="material-symbols-outlined text-[18px]">view_list</span>
                </button>
              </div>
            </div>

          </div>

        </div>
      </section>

      <!-- ==================== MAIN CATALOG SECTION ==================== -->
      <section class="w-full px-4 sm:px-6 lg:px-8 py-6">
        <div class="max-w-7xl mx-auto">

          <!-- Section Meta Status Header -->
          <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
            <div class="flex items-center gap-3">
              <div class="w-1.5 h-6 bg-primary-container rounded-full shadow-[0_0_8px_#ff0055]"></div>
              <h2 class="font-headline-sm text-xl font-bold text-white tracking-wide flex items-center gap-2"
                id="catalogSectionTitle">
                <i class="fas fa-tv text-secondary-container"></i> <span>Trending Anime</span>
